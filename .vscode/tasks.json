{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/windows/build-platformio.ps1"
        ]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/ubuntu/build-platformio.sh"
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/ubuntu/build-platformio.sh"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "PlatformIO: Upload (ST-Link)",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/windows/upload-platformio.ps1"
        ]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/ubuntu/upload-platformio.sh"
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/ubuntu/upload-platformio.sh"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "PlatformIO: Update Compile DB",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/windows/update-compile-commands.ps1"
        ]
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/ubuntu/update-compile-commands.sh"
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/ubuntu/update-compile-commands.sh"
      },
      "problemMatcher": []
    }
  ]
}
